// BentoDrop — Cloudflare Worker configuration.
// Designed for deployment via the Cloudflare GitHub integration (Workers Builds):
// connect this repo in the Cloudflare dashboard and set the deploy command to
// `npm run deploy` — it provisions D1/R2, generates secrets on first run, and
// applies migrations (scripts/deploy.mjs). Zero manual setup required.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bentodrop",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The PWA is a single-page app; API routes are handled by the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bentodrop",
      // No database_id on purpose: Cloudflare auto-provisions the database on
      // the first `wrangler deploy` (same as the R2 bucket below).
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INBOX",
      "bucket_name": "bentodrop-inbox"
    }
  ],
  "triggers": {
    // §10: expired messages / pairings cleanup. R2 lifecycle (7d) is the backstop.
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    // `mailto:` contact used as the VAPID `sub` claim.
    "VAPID_SUBJECT": "mailto:admin@example.com"
  },
  "observability": {
    "enabled": true
  }
  // Secrets — auto-generated on first `npm run deploy` (scripts/deploy.mjs):
  //   VAPID_PUBLIC_KEY   — base64url uncompressed P-256 point
  //   VAPID_PRIVATE_JWK  — matching private key as JWK JSON
  //   URL_SIGNING_SECRET — HMAC secret for short-lived upload/download URLs
}
