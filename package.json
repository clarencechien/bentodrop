{
  "name": "bentodrop",
  "version": "0.1.0",
  "private": true,
  "description": "BentoDrop 便當 — cross-device end-to-end encrypted inbox on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "gen-vapid": "node scripts/gen-vapid.mjs",
