{
  "name": "BentoDrop 便當",
  "short_name": "BentoDrop",
  "description": "跨裝置端到端加密信箱:文字、連結、照片,裝好送出拆開。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#E6EDEA",
  "theme_color": "#E6EDEA",
  "lang": "zh-Hant-TW",
  "related_applications": [
    { "platform": "webapp", "url": "https://bentodrop.ai-apps.work/manifest.webmanifest" }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "media", "accept": ["image/*"] }]
    }
  },
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
